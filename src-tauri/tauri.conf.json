{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MIS",
  "version": "1.0.0",
  "identifier": "com.vohrim.mis",

  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },

  "app": {
    "windows": [
      {
        "title": "MIS — Mistake Intelligence System",
        "width": 1300,
        "height": 860,
        "minWidth": 400,
        "minHeight": 520,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": true,
        "theme": "Dark",
        "backgroundColor": "#0e1217"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: asset: http://asset.localhost; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; form-action 'self'"
    }
  },

  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "vohrim",
    "copyright": "© vohrim",
    "category": "Education",
    "shortDescription": "Mistake Intelligence System",
    "longDescription": "MIS is a study app that turns the mistakes you make into a picture of how you are actually improving. Every score, paper and habit is kept in an encrypted vault on this device.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"],
        "displayLanguageSelector": false
      },
      "wix": {
        "language": ["en-US"]
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    }
  },

  "plugins": {}
}
