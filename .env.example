# Copy this file to `.env.local` and fill in the two values from your Supabase
# project (Dashboard → Project Settings → API). See SUPABASE_SETUP.md.
#
# Both of these are PUBLIC. Vite inlines them into the built HTML, so anyone who
# opens MIS.html can read them — that is normal and safe. The anon key only ever
# grants what the row-level-security policies in supabase/schema.sql allow, which
# is "your own rows and nobody else's".
#
# The `service_role` key is the opposite: it bypasses every policy. It must never
# appear in this file, in the app, or anywhere near the browser.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
